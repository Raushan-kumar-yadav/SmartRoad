// Database connection string
// Replace with your PostgreSQL password after install
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartroad"

// Server
PORT=8000

// Gmail SMTP - get App Password from:
// myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

// Ward notification webhook (simulated MCD endpoint)
// Replace with real MCD API URL when available
WARD_WEBHOOK_URL=http://localhost:8000/api/mock-mcd

// Notification settings
NOTIFY_EMAIL=ward_officer@mcd.delhi.gov.in
NOTIFY_ENABLED=true
